{
  "name": "brewlite-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "build:api": "npm run build --prefix apps/api",
    "build:web": "npm run build --prefix apps/web",
    "lint": "npm run lint --prefix apps/api && npm run lint --prefix apps/web",
    "test": "npm run test --prefix apps/api --if-present && npm run test --prefix apps/web --if-present",
    "test:api": "npm test --prefix apps/api",
    "test:integration": "node tests/integration/test-e2e-api.mjs",
    "test:concurrency": "node tests/integration/test-race-condition.mjs",
    "prisma:generate": "npm run db:generate --prefix apps/api",
    "prisma:migrate": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "prisma:seed": "tsx apps/api/prisma/seed.ts",
    "prisma:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma",
    "test:db": "node tests/integration/test-db.mjs"
  },
  "devDependencies": {
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "prisma": "7.10.1"
  }
}
