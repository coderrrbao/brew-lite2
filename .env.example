# --- Images & Tags ---
FRONTEND_IMAGE=brewlite-frontend
BACKEND_IMAGE=brewlite-backend
IMAGE_TAG=latest

# --- Service Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=4000
DB_EXPOSED_PORT=5433

# --- Database ---
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
# Docker compose dùng host "db". Chạy API ngoài Docker: đổi thành localhost:5433
DATABASE_URL=postgresql://brewlite:brewlite@db:5432/brewlite?schema=public

# --- Backend ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-super-secret-jwt-key
JWT_ACCESS_SECRET=dev-super-secret-access-key
JWT_REFRESH_SECRET=dev-super-secret-refresh-key

# --- Frontend ---
# Trình duyệt -> Backend
NEXT_PUBLIC_API_URL=http://localhost:4000
# Next.js SSR -> Backend qua mạng nội bộ Docker
INTERNAL_API_URL=http://backend:4000

# --- Test ---
# test-race-condition.mjs / test-db.mjs
TEST_DATABASE_URL=postgresql://brewlite:brewlite@localhost:5433/brewlite?schema=public

# --- Production (Supabase) ---
# Dùng cho prisma migrate deploy (kết nối trực tiếp, không qua pooler)
DIRECT_URL=
